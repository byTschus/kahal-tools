# Adresse des kahal.tools Servers (ohne / am Ende)
SERVER_URL=https://tools.deine-domain.ch
# Muss mit WORKER_TOKEN in der .env des Servers übereinstimmen
WORKER_TOKEN=
# Name des Workers in den Logs (optional)
WORKER_ID=infomaniak-worker-1
# Anzahl gleichzeitig verarbeiteter Podcasts. 1 = minimaler Ressourcenbedarf
WORKER_CONCURRENCY=1
# Wie oft nach neuen Aufträgen gefragt wird (Sekunden)
POLL_INTERVAL_SECONDS=20
# yt-dlp beim Start und täglich aktualisieren
YTDLP_AUTO_UPDATE=true
# YouTube über IPv6 laden (6), nur IPv4 (4) oder automatisch (leer).
# Auf Cloud-Servern blockiert YouTube IPv4-Adressen oft als Bot, IPv6 funktioniert meist.
YTDLP_IP_VERSION=6
# true = nur den Ausschnitt von YouTube laden statt der ganzen Audiospur (weniger Daten, aber fehleranfälliger)
YTDLP_SECTIONS=false
