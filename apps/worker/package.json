{
  "name": "@kahal/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Podcast-Worker: lädt YouTube-Audio, schneidet, kodiert MP3 und lädt es auf das Podcast-Hosting",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
