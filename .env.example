# ---------------------------------------------------------------
# kahal.tools – Konfiguration
# Kopieren nach ".env" und Werte ausfüllen (siehe docs/SETUP.md)
# ---------------------------------------------------------------

# Öffentliche URL, unter der das Tool erreichbar ist (ohne / am Ende).
# Lokal mit Vite-Devserver: http://localhost:5173
# Produktion: https://tools.deine-domain.ch
APP_URL=http://localhost:5173

PORT=3000
NODE_ENV=development

# Datenbank (MySQL / MariaDB). Lokal: Docker-Container "db" (siehe docker-compose.yml)
DATABASE_URL=mysql://kahal:kahal@localhost:3306/kahal

# Zufällige, lange Strings (z.B. "openssl rand -base64 48")
SESSION_SECRET=change-me-session-secret-min-32-chars-long
# Schlüssel zum Verschlüsseln von Zugangsdaten (Tokens, FTP-Passwörter) in der DB.
# ACHTUNG: Nach dem ersten Einsatz nicht mehr ändern, sonst sind gespeicherte Zugangsdaten unlesbar!
ENCRYPTION_KEY=change-me-encryption-key-min-32-chars-long

# Token, mit dem sich der Podcast-Worker beim Server authentifiziert
WORKER_TOKEN=change-me-worker-token

# Planning Center OAuth App (https://api.planningcenteronline.com/oauth/applications)
PCO_CLIENT_ID=
PCO_CLIENT_SECRET=

# Google / YouTube OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nur für lokale Entwicklung: Demo-Login ohne Planning Center (Fake-Gemeinde mit Testdaten)
ENABLE_MOCK_PLANNING=true

# Hintergrundaufgaben (Zuschauerzahlen abfragen, hängende Jobs zurücksetzen).
# Bei mehreren Server-Instanzen nur auf einer aktivieren.
RUN_SCHEDULER=true
