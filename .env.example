# ---------------------------------------------------------------
# kahal.tools – Konfiguration
# Kopieren nach ".env" und Werte ausfüllen (siehe docs/SETUP.md)
# ---------------------------------------------------------------

# Öffentliche URL, unter der das Tool erreichbar ist (ohne / am Ende).
# Lokal mit Vite-Devserver: http://localhost:5173
# Produktion: https://tools.deine-domain.ch
APP_URL=http://localhost:5173

PORT=3000
NODE_ENV=development

# Datenbank (MySQL / MariaDB). Lokal: Docker-Container "db" (siehe docker-compose.yml)
DATABASE_URL=mysql://kahal:kahal@localhost:3306/kahal

# Zufällige, lange Strings (z.B. "openssl rand -base64 48")
SESSION_SECRET=change-me-session-secret-min-32-chars-long
# Schlüssel zum Verschlüsseln von Zugangsdaten (Tokens, FTP-Passwörter) in der DB.
# ACHTUNG: Nach dem ersten Einsatz nicht mehr ändern, sonst sind gespeicherte Zugangsdaten unlesbar!
ENCRYPTION_KEY=change-me-encryption-key-min-32-chars-long

# Token, mit dem sich der Podcast-Worker beim Server authentifiziert
WORKER_TOKEN=change-me-worker-token

# OPTIONAL: globale OAuth-Apps für alle Gemeinden.
# Normalerweise trägt jede Gemeinde ihre eigenen Zugangsdaten im Webinterface ein
# ("Neue Gemeinde einrichten" bzw. Einstellungen -> Planungstool / Livestream).
# Werte hier dienen nur als Fallback für Gemeinden ohne eigene Zugangsdaten.
# Planning Center: https://api.planningcenteronline.com/oauth/applications
PCO_CLIENT_ID=
PCO_CLIENT_SECRET=
# Google / YouTube: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nur für lokale Entwicklung: Demo-Login ohne Planning Center (Fake-Gemeinde mit Testdaten)
ENABLE_MOCK_PLANNING=true

# E-Mail-Versand (Einladungen). Leer lassen = keine E-Mails, der Login-Link wird dann zum Kopieren angezeigt.
# Infomaniak Mail: SMTP_HOST=mail.infomaniak.com, SMTP_PORT=465, SMTP_USER = vollständige E-Mail-Adresse
# Lokal: Mailpit aus docker-compose -> SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false (Posteingang: http://localhost:8025)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Absender, z.B. "kahal.tools <noreply@deine-domain.ch>" (leer = SMTP_USER)
MAIL_FROM=

# Hintergrundaufgaben (Zuschauerzahlen abfragen, hängende Jobs zurücksetzen).
# Bei mehreren Server-Instanzen nur auf einer aktivieren.
RUN_SCHEDULER=true

# OPTIONAL: Worker-Server in der Infomaniak Public Cloud nur bei Bedarf laufen lassen (siehe docs/SETUP.md 6.4).
# Startet die Instanz, sobald Podcasts in der Warteschlange sind, und fährt sie nach der Leerlaufzeit herunter.
# Leer lassen = Worker läuft dauerhaft, kahal.tools steuert nichts.
OPENSTACK_AUTH_URL=https://api.pub1.infomaniak.cloud/identity/v3
OPENSTACK_REGION=
OPENSTACK_APP_CRED_ID=
OPENSTACK_APP_CRED_SECRET=
# ID der Instanz (Horizon: Compute -> Instances -> Name anklicken -> ID)
WORKER_SERVER_ID=
WORKER_SERVER_AUTO_START=true
WORKER_SERVER_AUTO_STOP=true
WORKER_SERVER_IDLE_MINUTES=15
